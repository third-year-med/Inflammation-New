function showArrow(x,y) {    var image = document.getElementById("arrow");    image.style.left = String(x) + 'px';    image.style.top = String(y) + 'px';}function showArrowb(x,y) {    var image = document.getElementById("arrowb");    image.style.left = String(x) + 'px';    image.style.top = String(y) + 'px';}function showArrowc(x,y) {    var image = document.getElementById("arrowc");    image.style.left = String(x) + 'px';    image.style.top = String(y) + 'px';}function xycoord(x,y) { if (document.getElementById)     {document.getElementById("arrow").style.top = y;				 	document.getElementById("arrow").style.left = x} else if (document.layers)     {document.arrow.top = y; document.arrow.left = x} else     {document.getElementById.arrow.style.top = y; document.getElementById.arrow.style.left = x}}function xycoord2(x,y) { if (document.getElementById)     {document.getElementById("arrowb").style.top = y;				 	document.getElementById("arrowb").style.left = x} else if (document.layers)     {document.arrowb.top = y; document.arrowb.left = x} else     {document.getElementById.arrowb.style.top = y; document.getElementById.arrowb.style.left = x}}function xycoord3(x,y) { if (document.getElementById)     {document.getElementById("arrowc").style.top = y;				 	document.getElementById("arrowc").style.left = x} else if (document.layers)     {document.arrowc.top = y; document.arrowc.left = x} else     {document.getElementById.arrowc.style.top = y; document.getElementById.arrowc.style.left = x}}function xycoord4(x,y) { if (document.getElementById)     {document.getElementById("circle").style.top = y;				 	document.getElementById("circle").style.left = x} else if (document.layers)     {document.circle.top = y; document.circle.left = x} else     {document.getElementById.circle.style.top = y; document.getElementById.circle.style.left = x}}function moveArrow(begin, end) {  if (begin < end) {  if (document.getElementById)  document.getElementById("arrow").style.top = (begin += 10); else   if (document.layers)  document.arrow.top = (begin += 10); else  {document.getElementById.arrow.style.top = (begin += 10)};  setTimeout('moveArrow(' + begin + ',' + end + ')', 20);}}function moveArrow2(begin, end) {  if (begin < end) {  if (document.getElementById)  document.getElementById("arrow").style.left = (begin += 10); else  if (document.layers)  document.arrow.left = (begin += 10); else  {document.getElementById.arrow.style.left = (begin += 10)};  setTimeout('moveArrow2(' + begin + ',' + end + ')', 20);}}function moveArrow3(begin, end) {  if (begin > end) {  if (document.getElementById)  document.getElementById("arrow").style.top = (begin -= 5); else  if (document.layers)  document.arrow.top = (begin -= 5); else  {document.getElementById.arrow.style.top = (begin -= 5)};  setTimeout('moveArrow3(' + begin + ',' + end + ')', 5);}}function PopImage(url,width,height) {	 target = window.open(url.href, url.target, 'resizable=yes,width=' + width + ',height=' + height +  ',status=no,location=no,toolbar=no,directories=no,menubar=no,scrollbars=yes');  popup.resizeTo(width,height);  return false;}function PopAnswer(num,width,height) {  newwindow=window.open('','name','width=300,height=300');  var tmp = newwindow.document;  var newItem = "<HEAD><LINK REL='stylesheet' HREF='../webpath.css'></HEAD><BODY>" newItem += (a[num]) newItem += "<BR><BR><A HREF='javascript:window.close()'>Close This Window</A></body></html>" tmp.write (newItem); newwindow.resizeTo(width,height); tmp.close();}function SetCookie (name, value) {  document.cookie = name + "=" + escape (value) + ";"}function setCounter(num) {  SetCookie ("cntr",num)}function floatingbox (num) {  if (num == 1)  {document.getElementById('text').innerHTML=' ';document.getElementById('text').style.visibility='hidden'}  else if (num == 2)  {document.getElementById('text').style.visibility='visible'}}function clearText() {  document.getElementById('text2').innerHTML= " ";}function spellOut(destination, message, speed){    var i = 0;    var interval = setInterval(function(){        document.getElementById(destination).innerHTML += message.charAt(i);        i++;        if (i > message.length){            clearInterval(interval);        }    }, speed);}function pauseAnimation() {  document.getElementById('dimensions').style.MozAnimationPlayState='paused';  document.getElementById('dimensions').style.WebkitAnimationPlayState='paused';  document.getElementById('dimensions').style.animationPlayState='paused';}function resumeAnimation() {  document.getElementById('dimensions').style.MozAnimationPlayState='running';  document.getElementById('dimensions').style.WebkitAnimationPlayState='running';  document.getElementById('dimensions').style.animationPlayState='running';}var button = document.getElementById('toggle-animation'),    el = document.getElementById('dimensions');button.onclick = function(){  el.classList.toggle('paused');}function startstopAnimation(){    var rotate = document.getElementById("dimensions");    if (!rotate.style.webkitAnimationPlayState) {                rotate.style.webkitAnimationPlayState = 'paused';    } else if (rotate.style.webkitAnimationPlayState === 'paused') {        rotate.style.webkitAnimationPlayState = 'running';          } else if (rotate.style.webkitAnimationPlayState === 'running') {        rotate.style.webkitAnimationPlayState = 'paused';           }}function startstopAnimationMoz(){    var rotate = document.getElementById("dimensions");    if (!rotate.style.MozAnimationPlayState) {                rotate.style.MozAnimationPlayState = 'paused';    } else if (rotate.style.MozAnimationPlayState === 'paused') {        rotate.style.MozAnimationPlayState = 'running';          } else if (rotate.style.MozAnimationPlayState === 'running') {        rotate.style.MozAnimationPlayState = 'paused';           }}